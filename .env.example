# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Free tier API key from resend.com for delivering real automated welcome emails.
# Add to Netlify Dashboard -> Site Configuration -> Environment Variables.
RESEND_API_KEY="re_123456789"

# SENDER_EMAIL: Sender address (e.g. Spanish with Meli <onboarding@resend.dev> or info@spanishconmeli.com)
SENDER_EMAIL="Spanish with Meli <onboarding@resend.dev>"

# TEACHER_EMAIL: Email where new student registration notifications will be forwarded
TEACHER_EMAIL="contact@spanishconmeli.com"

